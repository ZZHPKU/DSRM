{
  "name": "gaussian-comparison",
  "problem": {
    "factory": "DSRM.problems.manufactured:gaussian_problem",
    "kwargs": {"seed": 23, "d": 2, "modes": 3, "c": 0.5, "rho": 0.15, "epsilon": 0.1}
  },
  "model": {"width": 16, "hidden_layers": 2, "backend": "taylor"},
  "sampling": {"kind": "brownian"},
  "algorithms": {
    "pinn": {"kind": "pinn", "batch": 32, "schedule": [{"steps": 20, "lr": 0.001}]},
    "g": {
      "kind": "global", "batch": 8, "N": 4, "master_N": 4, "endpoint": "CURRENT",
      "schedule": [{"steps": 20, "lr": 0.001}]
    },
    "br": {
      "kind": "backward", "family": "G2", "batch": 32, "N": 4, "endpoint": "CURRENT",
      "schedule": [{"steps": 5, "lr": 0.001}]
    }
  },
  "runtime": {"device": "cpu", "dtype": "float32", "device_batch": 8, "threads": 1, "checkpoint_every": 10, "log_every": 10},
  "evaluation": {
    "validation_points": 64, "test_points": 128, "block": 32, "validate_every": 10,
    "layer_validation_points": 32, "layer_validation_block": 16, "layer_validate_every": 5
  },
  "seeds": {
    "initialization": 7, "train_occupation": 11, "train_path": 19,
    "validation_occupation": 13, "validation_path": 23, "test_occupation": 17, "test_terminal": 29
  }
}
